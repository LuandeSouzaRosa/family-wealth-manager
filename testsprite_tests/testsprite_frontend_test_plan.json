  {
    "id": "TC008",
    "title": "Create an expense transaction and verify it appears in the transactions list",
    "description": "Verifies a user can add a new transaction via the 'Nova Transação' dialog and see it listed afterward.",
    "category": "Transaction Management",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Login\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/\""
      },
      {
        "type": "action",
        "description": "Click on \"Transações\" in the main navigation"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/transacoes\""
      },
      {
        "type": "action",
        "description": "Click to open the \"Nova Transação\" dialog"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Nova Transação\" is visible"
      },
      {
        "type": "action",
        "description": "Type \"Mercado\" into the description field"
      },
      {
        "type": "action",
        "description": "Type \"123.45\" into the value field"
      },
      {
        "type": "action",
        "description": "Select \"Expense\" from the transaction type options"
      },
      {
        "type": "action",
        "description": "Select a category from the category dropdown"
      },
      {
        "type": "action",
        "description": "Type \"2026-03-01\" into the date field"
      },
      {
        "type": "action",
        "description": "Click the submit button in the dialog"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Mercado\" is visible"
      }
    ]
  },
