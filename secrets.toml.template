# --- Google Sheets (backend atual) ---
[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit#gid=0"
service_account = "google-credentials.json"

# --- Autenticação ---
[auth]
enabled = true

[auth.users.luan]
name = "Luan"
# IMPORTANTE: Use hash SHA-256 da senha, NÃO plaintext!
# Gerar hash: python -c "import hashlib; print(hashlib.sha256(b'SUA_SENHA').hexdigest())"
password = "COLE_O_HASH_SHA256_AQUI"

[auth.users.luana]
name = "Luana"
password = "COLE_O_HASH_SHA256_AQUI"

# --- Supabase (Fase 4 — migração futura) ---
